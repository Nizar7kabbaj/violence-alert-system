# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/vas?retryWrites=true&w=majority
MONGODB_DB_NAME=vas

# JWT secrets
JWT_SECRET=replace_me_with_64_byte_hex
JWT_REFRESH_SECRET=replace_me_with_a_DIFFERENT_64_byte_hex
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
ENVIRONMENT=development

# Rate limiting
RATE_LIMIT_LOGIN=5/minute

# ML detection
DETECTION_THRESHOLD=0.85

# Internal service-to-service API key
INTERNAL_API_KEY=replace_me_with_64_byte_hex

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Observability
METRICS_ALLOWED_IPS=127.0.0.1

# Watcher
WATCHER_EMAIL=
WATCHER_PASSWORD=
WATCHER_POLL_INTERVAL=10